                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Restablecer contrasena",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
