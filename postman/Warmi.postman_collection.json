{
  "info": {
    "name": "Warmi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "JWT y estados. Sin DELETE, seeds ni carga automatica de datos. Completa variables con tu cuenta manual; consulta docs/POSTMAN.md. No ejecutar todas las carpetas con Runner sin revisar bajas y contrasenas."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "correo",
      "value": "",
      "type": "string"
    },
    {
      "key": "contrasena",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "persona_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "paciente_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuario_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "personal_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "rol_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "permiso_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "configuracion_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "auditoria_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "acceso_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "nueva_contrasena",
      "value": "",
      "type": "string"
    },
    {
      "key": "recovery_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_acceso\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "if (pm.response.code !== 200) pm.collectionVariables.unset('token');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Recuperar contrasena",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_acceso\": \"{{correo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
