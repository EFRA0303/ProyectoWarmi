            ],
            "url": "{{base_url}}/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contrasena_actual\": \"{{contrasena}}\",\n  \"nueva_contrasena\": \"{{nueva_contrasena}}\"\n}",
              "options": {
